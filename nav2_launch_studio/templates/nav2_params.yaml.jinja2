{#- 递归宏：将 params 字典渲染为 YAML 键值对 -#}
{% macro render_params(params, indent=4) %}
{% for key, value in params.items() %}
{% if not key.startswith('_') %}
{% if value is mapping %}
{{ " " * indent }}{{ key }}:
{{ render_params(value, indent + 2) }}
{% elif value is sequence and value is not string %}
{{ " " * indent }}{{ key }}: {{ value | yaml_list }}
{% else %}
{{ " " * indent }}{{ key }}: {{ value | yaml_value }}
{% endif %}
{% endif %}
{% endfor %}
{% endmacro %}
{#- 已知节点集合，用于区分已知/未知节点 -#}
{% set known_nodes = ['amcl', 'bt_navigator', 'controller_server', 'planner_server', 'behavior_server', 'velocity_smoother', 'waypoint_follower', 'map_server', 'lifecycle_manager'] %}
# ============================================================
# Nav2 Parameters - Generated by Nav2 Launch Studio
# Project: {{ project_name }}
# ROS2 Version: {{ ros2_version }}
# Robot Type: {{ robot_type }}
{% if namespace %}# Namespace: {{ namespace }}
{% endif %}# ============================================================
{% if 'amcl' in enabled_nodes %}
amcl:
  ros__parameters:
{% if node_params.get('amcl') %}
{{ render_params(node_params['amcl'], 4) }}
{% endif %}
{% endif %}
