# YAML template for nav2_params.yaml generation
# Used by Jinja2 to render the final YAML output

# ============================================================
# Nav2 Parameters - Generated by Nav2 Launch Studio
# Project: {{ project_name }}
# ROS2 Version: {{ ros2_version }}
# Robot Type: {{ robot_type }}
{% if namespace %}# Namespace: {{ namespace }}
{% endif %}# ============================================================

{% if 'amcl' in enabled_nodes %}
amcl:
  ros__parameters:
{% if amcl_params %}
{% for key, value in amcl_params.items() %}
    {{ key }}: {{ value | yaml_value }}
{% endfor %}
{% else %}
    use_sim_time: false
    alpha1: 0.2
    alpha2: 0.2
    alpha3: 0.2
    alpha4: 0.2
    alpha5: 0.2
{% endif %}

{% endif %}{% if 'bt_navigator' in enabled_nodes %}
bt_navigator:
  ros__parameters:
    use_sim_time: false
    global_frame: map
    robot_base_frame: base_link
    odom_topic: /odom
    bt_loop_duration: 10
    default_server_timeout: 20
    wait_for_service_timeout: 1000
    action_server_result_timeout: 900.0
    navigators: ["navigate_to_pose", "navigate_through_poses"]
    navigate_to_pose:
      plugin: "nav2_bt_navigator::NavigateToPoseNavigator"
    navigate_through_poses:
      plugin: "nav2_bt_navigator::NavigateThroughPosesNavigator"
    error_code_names:
      - compute_path_error_code
      - follow_path_error_code
    default_bt_xml_filename: {{ bt_tree }}
{% if bt_navigator_params %}
{% for key, value in bt_navigator_params.items() %}
    {{ key }}: {{ value | yaml_value }}
{% endfor %}
{% endif %}

{% endif %}{% if 'controller_server' in enabled_nodes %}
controller_server:
  ros__parameters:
    use_sim_time: false
    controller_frequency: 20.0
    min_x_velocity_threshold: 0.001
    min_y_velocity_threshold: 0.5
    min_theta_velocity_threshold: 0.001
    progress_checker_plugins: ["progress_checker"]
    goal_checker_plugins: ["general_goal_checker"]
    controller_plugins: ["FollowPath"]
    progress_checker:
      plugin: "nav2_controller::SimpleProgressChecker"
      required_movement_radius: 0.5
      movement_time_allowance: 10.0
    general_goal_checker:
      plugin: "nav2_controller::SimpleGoalChecker"
      stateful: true
      xy_goal_tolerance: 0.25
      yaw_goal_tolerance: 0.25
    FollowPath:
      plugin: "{{ controller_plugin_type }}"
{% if controller_params %}
{% for key, value in controller_params.items() %}
      {{ key }}: {{ value | yaml_value }}
{% endfor %}
{% endif %}

{% endif %}{% if 'planner_server' in enabled_nodes %}
planner_server:
  ros__parameters:
    expected_planner_frequency: 20.0
    use_sim_time: false
    planner_plugins: ["GridBased"]
    GridBased:
      plugin: "{{ planner_plugin_type }}"
{% if planner_params %}
{% for key, value in planner_params.items() %}
      {{ key }}: {{ value | yaml_value }}
{% endfor %}
{% endif %}

{% endif %}{% if 'behavior_server' in enabled_nodes %}
behavior_server:
  ros__parameters:
    costmap_topic: local_costmap/costmap_raw
    footprint_topic: local_costmap/published_footprint
    cycle_frequency: 10.0
    behavior_plugins: ["spin", "backup", "drive_on_heading", "wait"]
{% for behavior in recovery_behaviors %}
    {{ behavior.instance_name }}:
      plugin: "{{ behavior.plugin_type }}"
{% if behavior.params %}
{% for key, value in behavior.params.items() %}
      {{ key }}: {{ value | yaml_value }}
{% endfor %}
{% endif %}
{% endfor %}

{% endif %}{% if 'velocity_smoother' in enabled_nodes %}
velocity_smoother:
  ros__parameters:
    smoothing_frequency: 20.0
    scale_velocities: false
    feedback: "odom"
    max_velocity: [0.26, 0.0, 1.0]
    min_velocity: [-0.26, 0.0, -1.0]
    max_accel: [2.5, 0.0, 3.2]
    max_decel: [-2.5, 0.0, -3.2]
    odom_topic: "odom"
    odom_duration: 0.1
    deadband_velocity: [0.0, 0.0, 0.0]
    velocity_timeout: 1.0

{% endif %}{% if 'waypoint_follower' in enabled_nodes %}
waypoint_follower:
  ros__parameters:
    use_sim_time: false
    loop_rate: 20
    stop_on_failure: false
    waypoint_task_executor_plugin: "wait_at_waypoint"
    wait_at_waypoint:
      plugin: "nav2_waypoint_follower::WaitAtWaypoint"
      enabled: true
      waypoint_pause_duration: 200

{% endif %}
# ---- Costmap 2D ROS ----
global_costmap:
  global_costmap:
    ros__parameters:
      update_frequency: 1.0
      publish_frequency: 1.0
      global_frame: map
      robot_base_frame: base_link
      use_sim_time: false
      robot_radius: 0.22
      resolution: 0.05
      track_unknown_space: true
      plugins: {{ global_costmap_plugins | yaml_list }}
{% for layer in global_costmap_layers %}
      {{ layer.instance_name }}:
        plugin: "{{ layer.plugin_type }}"
{% if layer.params %}
{% for key, value in layer.params.items() %}
        {{ key }}: {{ value | yaml_value }}
{% endfor %}
{% endif %}
{% endfor %}
      always_send_full_costmap: true

local_costmap:
  local_costmap:
    ros__parameters:
      update_frequency: 5.0
      publish_frequency: 5.0
      global_frame: odom
      robot_base_frame: base_link
      use_sim_time: false
      rolling_window: true
      width: 3
      height: 3
      resolution: 0.05
      robot_radius: 0.22
      plugins: {{ local_costmap_plugins | yaml_list }}
{% for layer in local_costmap_layers %}
      {{ layer.instance_name }}:
        plugin: "{{ layer.plugin_type }}"
{% if layer.params %}
{% for key, value in layer.params.items() %}
        {{ key }}: {{ value | yaml_value }}
{% endfor %}
{% endif %}
{% endfor %}
      always_send_full_costmap: true
